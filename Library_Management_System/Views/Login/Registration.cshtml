@model Book;


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="vh-100 mt-5">
    <div class="container-fluid h-custom">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-md-9 col-lg-6 col-xl-5">
                <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login" />
            </div>
        </div>
    </div>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="container">
            <h1>Register</h1>
            @* <p>Please fill in this form to create an account.</p> *@
            <hr>

            <label asp-for="BookName"></label>
            <input asp-for="BookName" class="form-control"
                   placeholder="enter a Book Name" />
            <span asp-validation-for="BookName" class="text-danger"></span>

            <label asp-for="Author"></label>
            <input asp-for="Author" class="form-control" placeholder="Enter Author Name" />
            <span asp-validation-for="Author" class="text-danger"></span>

            <label asp-for="Language"></label>
            <input asp-for="Language" class="form-control" placeholder="Language" />
            <span asp-validation-for="Language" class="text-danger"></span>
            <br />
            <label asp-for="Status"></label>
            <input type="hidden" asp-for="Status" type="hiddden" value="Pending" />

            <br />


            <hr>

            <p>By creating an account you agree to our <a href="#">Terms & Privacy</a>.</p>
            <button type="submit" asp-for="" asp-controller="Login" asp-action="Registration" class="btn btn-success"> Register</button>
        </div>


    </form>


















